<%- include('partials/header') -%>
<div class="container">
  <div class="row justify-content-center mt-5">
    <div class="col-12 col-lg-9">
      <article class="content-panel post-detail">
        <h2><%= post.title %></h2>

        <img
          class="post-detail-image"
          src="<%= post.image %>"
          alt="<%= post.title %>"
        >

        <div class="post-detail-actions">
          <form
            action="/post/likePost/<%= post.id %>?_method=PUT"
            method="POST"
          >
            <button class="btn btn-primary" type="submit" aria-label="Like post">
              <i class="fa fa-heart"></i>
            </button>
          </form>

          <span class="post-like-count">Likes: <%= post.likes %></span>

          <% if (post.user == user.id) { %>
            <form
              action="/post/deletePost/<%= post.id %>?_method=DELETE"
              method="POST"
            >
              <button class="btn btn-outline-danger" type="submit" aria-label="Delete post">
                <i class="fa fa-trash"></i>
              </button>
            </form>
          <% } %>
        </div>

        <% if (post.caption) { %>
          <div class="post-caption">
            <p><%= post.caption %></p>
          </div>
        <% } %>
      </article>
    </div>
    <div class="mt-5">
      <h2>Add a comment</h2>
      <form action="/comment/createComment/<%=post._id%>" method="POST">
        <div class="mb-3">
            <label for="title" class="form-label">Comment</label>
            <input type="text" class="form-control" id="comment" name="comment">
        </div>
        <button type="submit" class="btn btn-primary">Submit</button>
      </form>
    </div>
    <ul class="comment-list">
      <% comments.forEach((comment) => { %>
        <%- include("partials/comment", { comment: comment, post: post, user: user }) %>
      <% }) %>
    </ul>
    <div class="col-12 d-flex justify-content-center gap-3 mt-5">
      <a class="btn btn-primary" href="/profile">Return to Profile</a>
      <a class="btn btn-primary" href="/feed">Return to Feed</a>
    </div>
  </div>
</div>

<%- include('partials/footer') -%>
