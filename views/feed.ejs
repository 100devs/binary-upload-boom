<%- include('partials/header') -%>
  <div class="container">
    <div class="row justify-content-center mt-5">
      <ul class="row list-unstyled post-grid">
        <% for(var i=0; i<posts.length; i++) {%>
          <li class="col-12 col-md-6 col-lg-4 mt-4">
            <a href="/post/<%= posts[i]._id%>" class="post-thumbnail">
              <img class="post-thumbnail-bg" src="<%= posts[i].image %>" alt="" aria-hidden="true">
              <img class="post-thumbnail-img" src="<%= posts[i].image %>" alt="Post image">
            </a>
          </li>
        <% } %>
        </ul>
    </div>
  </div>  
<%- include('partials/footer') -%>