<!-- includes header for page from partials directory -->
<%- include('partials/header') -%>
  <div class="container">
    <div class="row justify-content-center mt-5">
      <ul class="row list-unstyled">
        <!-- dynamic UI, creates a list item for each post present within the posts array -->
        <% for(var i=0; i<posts.length; i++) {%>
          <!-- styles apply to every instance -->
          <li class="col-6 justify-content-between mt-5">
            <!-- links to post -->
            <a href="/post/<%= posts[i]._id%>">
              <!-- img src linking to each specific post -->
              <img class="img-fluid" src="<%= posts[i].image%>">
            </a>
          </li>
        <% } %>
        </ul>
    </div>
  </div>
  <!-- include the page footer created in partials directory -->
<%- include('partials/footer') -%>